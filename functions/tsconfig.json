{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types", "node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "**/*.ts",
    "../artifacts/api-server/src/services/githubDeveloperSecurity.ts",
    "../artifacts/api-server/src/services/githubIntegration.ts"
  ]
}
