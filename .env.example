# Backend-only environment variables. Set real values in your hosting provider's
# private environment-variable settings; do not commit a real .env file.
NODE_ENV=production
PORT=3000
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=

# GitHub OAuth App (callback must be https://<api-host>/api/github/oauth/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
# Comma-separated numeric GitHub account IDs allowed to act as Owner.
GITHUB_OWNER_IDS=
# Generate with: openssl rand -hex 32
GITHUB_SESSION_SECRET=
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes)
GITHUB_TOKEN_ENCRYPTION_KEY=
# Exact public frontend origin, e.g. https://app.example.com
APP_ORIGIN=

# Optional for frontend builds
BASE_PATH=/
